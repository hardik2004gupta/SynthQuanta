# SynthQuanta backend environment variables
# Copy to .env and fill in real values. Never commit .env.

APP_NAME=SynthQuanta
APP_ENV=development
API_PREFIX=/api/v1

# PostgreSQL — adjust host/port/credentials for your local setup
DATABASE_URL=postgresql://synthquanta:synthquanta@localhost:5432/synthquanta

# Filesystem path where generated artifacts are stored (datasets, models, benchmarks)
# Relative to the backend/ directory when running locally, or absolute path.
ARTIFACT_ROOT=../artifacts

# CORS — JSON list of allowed frontend origins (pydantic-settings v2 requires JSON for list fields)
CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
